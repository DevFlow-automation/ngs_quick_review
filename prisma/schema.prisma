generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AnswerOption {
  A
  B
  C
  D
}

enum SessionStatus {
  ACTIVE
  FINISHED
}

enum TeacherRole {
  TEACHER
  ADMIN
}

model Teacher {
  id        String      @id @default(cuid())
  fullName  String
  subject   String
  pinCode   String      // 4-значный PIN для быстрого входа
  role      TeacherRole @default(TEACHER)
  createdAt DateTime    @default(now())
  quizzes   Quiz[]
  sessions  Session[]
}

model Class {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  students  Student[]
  sessions  Session[]
}

model Student {
  id        String     @id @default(cuid())
  fullName  String
  markerId  Int
  classId   String
  class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  responses Response[]

  @@unique([classId, markerId])
  @@index([classId])
}

model Quiz {
  id        String     @id @default(cuid())
  title     String
  subject   String?
  isShared  Boolean    @default(false) // Доступен ли тест другим учителям
  teacherId String?
  teacher   Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  questions Question[]
  sessions  Session[]

  @@index([teacherId])
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order         Int
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption AnswerOption
  responses     Response[]

  @@index([quizId, order])
}

model Session {
  id                 String        @id @default(cuid())
  code               String        @unique
  classId            String
  class              Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  quizId             String
  quiz               Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  teacherId          String?
  teacher            Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  currentQuestionIdx Int           @default(0)
  revealAnswer       Boolean       @default(false)
  status             SessionStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  responses          Response[]

  @@index([status])
  @@index([teacherId])
}

model Response {
  id         String       @id @default(cuid())
  sessionId  String
  session    Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answer     AnswerOption
  isCorrect  Boolean
  scannedAt  DateTime     @updatedAt

  @@unique([sessionId, questionId, studentId])
  @@index([sessionId, questionId])
}
